# Copy this file to ".env" in the project root before running
# `docker compose up`. Values here are examples only - never commit
# the real ".env".

# ── Django ──────────────────────────────────────────────────────
# Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.prod

# ── PostgreSQL ──────────────────────────────────────────────────
# Used both by the `db` service (as POSTGRES_*) and by Django
# (as DB_*) - see docker-compose.yml. DB_HOST/DB_PORT below are for
# reference only; docker-compose.yml overrides them to "db"/5432 so
# the backend container talks to the `db` service, not localhost.
DB_NAME=hris_unimugo
DB_USER=hris_unimugo
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ── JWT ─────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Seed data (seed_initial_data management command) ────────────
# Kredensial akun Admin yang dibuat otomatis oleh entrypoint.sh saat
# container backend naik dari database kosong. WAJIB diisi (command
# akan gagal kalau kosong) - jangan pakai nilai contoh ini di staging
# apalagi produksi.
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Never use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── HTTPS ───────────────────────────────────────────────────────
# Keep False until Nginx is fronted by Certbot/Let's Encrypt with a
# real cert (see nginx/conf.d/default.conf for how to add it later).
SECURE_SSL_REDIRECT=False
